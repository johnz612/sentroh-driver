{
  "expo": {
    "name": "Sentroh Driver",
    "slug": "sentroh-driver",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sentrohdriver",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.sentroh.driver",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CALL_PHONE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#161616"
      }
    },
    "ios": {
      "bundleIdentifier": "com.sentroh.driver",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Sentroh uses your location to offer you nearby deliveries and to show customers where their order is."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#161616"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F5B700"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sentroh uses your location to offer you nearby deliveries and to show customers where their order is."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sentroh uses your photos for proof of delivery.",
          "cameraPermission": "Sentroh uses the camera to take a proof-of-delivery photo.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {}
    },
    "icon": "./assets/icon.png"
  }
}
